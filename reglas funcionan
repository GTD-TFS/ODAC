rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       FUNCIONES GENERALES
    ========================== */

    function isPolice() {
      return request.auth != null;
    }

    function tokenOk(token) {
      return exists(/databases/$(database)/documents/tokenSessions/$(token))
        && get(/databases/$(database)/documents/tokenSessions/$(token)).data.revoked == false
        && request.time < get(/databases/$(database)/documents/tokenSessions/$(token)).data.expiresAt;
    }

function isValidFinalPredCreate(id){
  return request.resource.data.keys().hasOnly([
      "estado","tipo","token","hechos","createdAt","finalizedAt",
      "doc","crimeType","filiacion_enc","label_publico","sexo_publico"
    ])
    && request.resource.data.estado == "FINALIZADA"
    && request.resource.data.token == id
    && request.resource.data.tipo is string
    && request.resource.data.hechos is map
    && !("docText" in request.resource.data);
}

function isValidFinalPredUpdate(id){
  // En update NO uses hasOnly() porque el doc puede traer campos antiguos
  return request.resource.data.estado == "FINALIZADA"
    && request.resource.data.token == id
    && request.resource.data.tipo is string
    && request.resource.data.hechos is map
    && !("docText" in request.resource.data);
}

function isValidInboxCreate(){
  return request.resource.data.keys().hasAll(["createdAt","expiresAt"])
    && request.resource.data.createdAt is timestamp
    && request.resource.data.expiresAt is timestamp
    && request.resource.data.createdAt >= request.time - duration.value(1, "m")
    && request.resource.data.createdAt <= request.time + duration.value(1, "m")
    && request.resource.data.expiresAt > request.resource.data.createdAt
    && request.resource.data.expiresAt <= request.resource.data.createdAt + duration.value(8, "h");
}
    

    /* =========================
       TOKENS
    ========================== */

  match /tokenSessions/{token} {
  allow get: if true;      // necesario para tokenOk() sin login
  allow list: if isPolice();
  allow create, update, delete: if isPolice();
}

    /* =========================
       PREDENUNCIAS
    ========================== */

   match /predenuncias/{id} {

  allow read, create, update, delete: if isPolice();

  allow create: if tokenOk(id) && isValidFinalPredCreate(id);

  allow update: if tokenOk(id)
    && isValidFinalPredUpdate(id)
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      "estado","tipo","token","hechos","createdAt","finalizedAt",
      "doc","crimeType","filiacion_enc","label_publico","sexo_publico"
    ]);
}

    /* =========================
       REGISTROS CIFRADOS COMPAPOL
    ========================== */

    match /registros/{id} {
      allow read, create, update, delete: if isPolice();
    }

    /* =========================
       DENUPOL INBOX (LABEJAR → DENUPOL)
    ========================== */

    match /denupolInbox/{id} {

      // LABEJAR autenticado → SOLO CREATE
      allow create: if request.auth != null
        && isValidInboxCreate();

      // DENUPOL / policía → lectura total
      allow read, update, delete: if isPolice();
    }

  }
}
